# Copy this file to .env (gitignored) and set real values before running:
#   docker compose up
#
# Must satisfy SQL Server's password policy (8+ chars, upper+lower+digit or symbol).
MSSQL_SA_PASSWORD=Your_strong_password123

# Signing key for issued JWTs - anyone with this value can forge valid tokens for this API.
# Use a long, random value (32+ characters) in any real deployment; never reuse the
# appsettings.Development.json dev-only key outside your local machine.
JWT_SIGNING_KEY=Your_random_signing_key_at_least_32_characters_long
